defines = -DNDEBUG
framework_dirs =
include_dirs =
cflags = -mavx2 -mf16c -std=c11 -Wno-attributes -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -DSK_DISABLE_LEGACY_PNG_WRITEBUFFER
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti
root_out_dir = .
target_output_name = skcms_TransformHsw

build obj/modules/skcms/src/skcms_TransformHsw.skcms_TransformHsw.o: cxx ../skia/modules/skcms/src/skcms_TransformHsw.cc

build obj/modules/skcms/skcms_TransformHsw.stamp: stamp obj/modules/skcms/src/skcms_TransformHsw.skcms_TransformHsw.o
