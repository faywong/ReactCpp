defines = -DNDEBUG
framework_dirs =
include_dirs =
cflags = -mavx512f -mavx512dq -mavx512cd -mavx512bw -mavx512vl -std=c11 -Wno-attributes -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -DSK_DISABLE_LEGACY_PNG_WRITEBUFFER
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti
root_out_dir = .
target_output_name = skcms_TransformSkx

build obj/modules/skcms/src/skcms_TransformSkx.skcms_TransformSkx.o: cxx ../skia/modules/skcms/src/skcms_TransformSkx.cc

build obj/modules/skcms/skcms_TransformSkx.stamp: stamp obj/modules/skcms/src/skcms_TransformSkx.skcms_TransformSkx.o
