defines = -DNDEBUG -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_HIDE_PATH_EDIT_METHODS -DSK_R32_SHIFT=16 -DSK_ENABLE_PRECOMPILE -DSK_DISABLE_TRACING -DSK_USE_PERFETTO -DSK_GAMMA_APPLY_TO_A8 -DSK_ENABLE_AVX512_OPTS -DSKIA_IMPLEMENTATION=1
framework_dirs =
include_dirs = -I../skia
cflags = -Wno-attributes -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -DSK_DISABLE_LEGACY_PNG_WRITEBUFFER
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti
root_out_dir = .
target_output_name = pathops

build obj/src/pathops/pathops.SkAddIntersections.o: cxx ../skia/src/pathops/SkAddIntersections.cpp
build obj/src/pathops/pathops.SkDConicLineIntersection.o: cxx ../skia/src/pathops/SkDConicLineIntersection.cpp
build obj/src/pathops/pathops.SkDCubicLineIntersection.o: cxx ../skia/src/pathops/SkDCubicLineIntersection.cpp
build obj/src/pathops/pathops.SkDCubicToQuads.o: cxx ../skia/src/pathops/SkDCubicToQuads.cpp
build obj/src/pathops/pathops.SkDLineIntersection.o: cxx ../skia/src/pathops/SkDLineIntersection.cpp
build obj/src/pathops/pathops.SkDQuadLineIntersection.o: cxx ../skia/src/pathops/SkDQuadLineIntersection.cpp
build obj/src/pathops/pathops.SkIntersections.o: cxx ../skia/src/pathops/SkIntersections.cpp
build obj/src/pathops/pathops.SkOpAngle.o: cxx ../skia/src/pathops/SkOpAngle.cpp
build obj/src/pathops/pathops.SkOpBuilder.o: cxx ../skia/src/pathops/SkOpBuilder.cpp
build obj/src/pathops/pathops.SkOpCoincidence.o: cxx ../skia/src/pathops/SkOpCoincidence.cpp
build obj/src/pathops/pathops.SkOpContour.o: cxx ../skia/src/pathops/SkOpContour.cpp
build obj/src/pathops/pathops.SkOpCubicHull.o: cxx ../skia/src/pathops/SkOpCubicHull.cpp
build obj/src/pathops/pathops.SkOpEdgeBuilder.o: cxx ../skia/src/pathops/SkOpEdgeBuilder.cpp
build obj/src/pathops/pathops.SkOpSegment.o: cxx ../skia/src/pathops/SkOpSegment.cpp
build obj/src/pathops/pathops.SkOpSpan.o: cxx ../skia/src/pathops/SkOpSpan.cpp
build obj/src/pathops/pathops.SkPathOpsAsWinding.o: cxx ../skia/src/pathops/SkPathOpsAsWinding.cpp
build obj/src/pathops/pathops.SkPathOpsCommon.o: cxx ../skia/src/pathops/SkPathOpsCommon.cpp
build obj/src/pathops/pathops.SkPathOpsConic.o: cxx ../skia/src/pathops/SkPathOpsConic.cpp
build obj/src/pathops/pathops.SkPathOpsCubic.o: cxx ../skia/src/pathops/SkPathOpsCubic.cpp
build obj/src/pathops/pathops.SkPathOpsCurve.o: cxx ../skia/src/pathops/SkPathOpsCurve.cpp
build obj/src/pathops/pathops.SkPathOpsDebug.o: cxx ../skia/src/pathops/SkPathOpsDebug.cpp
build obj/src/pathops/pathops.SkPathOpsLine.o: cxx ../skia/src/pathops/SkPathOpsLine.cpp
build obj/src/pathops/pathops.SkPathOpsOp.o: cxx ../skia/src/pathops/SkPathOpsOp.cpp
build obj/src/pathops/pathops.SkPathOpsQuad.o: cxx ../skia/src/pathops/SkPathOpsQuad.cpp
build obj/src/pathops/pathops.SkPathOpsRect.o: cxx ../skia/src/pathops/SkPathOpsRect.cpp
build obj/src/pathops/pathops.SkPathOpsSimplify.o: cxx ../skia/src/pathops/SkPathOpsSimplify.cpp
build obj/src/pathops/pathops.SkPathOpsTSect.o: cxx ../skia/src/pathops/SkPathOpsTSect.cpp
build obj/src/pathops/pathops.SkPathOpsTightBounds.o: cxx ../skia/src/pathops/SkPathOpsTightBounds.cpp
build obj/src/pathops/pathops.SkPathOpsTypes.o: cxx ../skia/src/pathops/SkPathOpsTypes.cpp
build obj/src/pathops/pathops.SkPathOpsWinding.o: cxx ../skia/src/pathops/SkPathOpsWinding.cpp
build obj/src/pathops/pathops.SkPathWriter.o: cxx ../skia/src/pathops/SkPathWriter.cpp
build obj/src/pathops/pathops.SkReduceOrder.o: cxx ../skia/src/pathops/SkReduceOrder.cpp

build obj/pathops.stamp: stamp obj/src/pathops/pathops.SkAddIntersections.o obj/src/pathops/pathops.SkDConicLineIntersection.o obj/src/pathops/pathops.SkDCubicLineIntersection.o obj/src/pathops/pathops.SkDCubicToQuads.o obj/src/pathops/pathops.SkDLineIntersection.o obj/src/pathops/pathops.SkDQuadLineIntersection.o obj/src/pathops/pathops.SkIntersections.o obj/src/pathops/pathops.SkOpAngle.o obj/src/pathops/pathops.SkOpBuilder.o obj/src/pathops/pathops.SkOpCoincidence.o obj/src/pathops/pathops.SkOpContour.o obj/src/pathops/pathops.SkOpCubicHull.o obj/src/pathops/pathops.SkOpEdgeBuilder.o obj/src/pathops/pathops.SkOpSegment.o obj/src/pathops/pathops.SkOpSpan.o obj/src/pathops/pathops.SkPathOpsAsWinding.o obj/src/pathops/pathops.SkPathOpsCommon.o obj/src/pathops/pathops.SkPathOpsConic.o obj/src/pathops/pathops.SkPathOpsCubic.o obj/src/pathops/pathops.SkPathOpsCurve.o obj/src/pathops/pathops.SkPathOpsDebug.o obj/src/pathops/pathops.SkPathOpsLine.o obj/src/pathops/pathops.SkPathOpsOp.o obj/src/pathops/pathops.SkPathOpsQuad.o obj/src/pathops/pathops.SkPathOpsRect.o obj/src/pathops/pathops.SkPathOpsSimplify.o obj/src/pathops/pathops.SkPathOpsTSect.o obj/src/pathops/pathops.SkPathOpsTightBounds.o obj/src/pathops/pathops.SkPathOpsTypes.o obj/src/pathops/pathops.SkPathOpsWinding.o obj/src/pathops/pathops.SkPathWriter.o obj/src/pathops/pathops.SkReduceOrder.o || obj/core.stamp obj/fontmgr_FontConfigInterface.stamp obj/fontmgr_android.stamp obj/fontmgr_android_ndk.stamp obj/fontmgr_custom_directory.stamp obj/fontmgr_custom_embedded.stamp obj/fontmgr_custom_empty.stamp obj/fontmgr_fontations_empty.stamp obj/fontmgr_fontconfig.stamp obj/fontmgr_mac_ct.stamp obj/fontmgr_win.stamp obj/fontmgr_win_gdi.stamp obj/png_decode_libpng.stamp obj/png_encode_libpng.stamp obj/typeface_fontations.stamp
