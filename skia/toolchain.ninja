rule ___skia.h___gn_toolchain_gcc_like__rule
  command = python3 ../skia/gn/find_headers.py /_w/skia/bin/gn /_w/skia/ gen/skia.h /_w/skia/client_utils/android /_w/skia/include/android /_w/skia/include/codec /_w/skia/include/config /_w/skia/include/core /_w/skia/include/docs /_w/skia/include/effects /_w/skia/include/encode /_w/skia/include/gpu /_w/skia/include/pathops /_w/skia/include/ports /_w/skia/include/svg /_w/skia/include/utils /_w/skia/include/utils/mac /_w/skia/modules/skottie/include /_w/skia/modules/skparagraph/include /_w/skia/modules/skshaper/include /_w/skia/modules/svg/include
  description = ACTION //:skia.h(//gn/toolchain:gcc_like)
  restat = 1

build gen/skia.h: ___skia.h___gn_toolchain_gcc_like__rule | ../skia/gn/find_headers.py
